<h1>Editar usuário</h1>
<form action="/usuarios/<%= usuario.id %>?_method=PUT" method="POST">
    <div class="form-group">
        <label for="nome">nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= usuario.nome %>" required>
    </div>
    <div class="form-group">
        <label for="senha">senha</label>
        <input type="senha" class="form-control" id="senha" name="senha" value="<%= usuario.senha %>" required>
    </div>
    <div class="form-group">
        <label for="funcao">função</label>
        <select class="form-control" id="funcao" name="funcao" required>
            <option value="admin" <%= usuario.funcao === 'admin' ? 'selected' : '' %>>Admin</option>
            <option value="usuario" <%= usuario.funcao === 'usuario' ? 'selected' : '' %>>usuario</option>
        </select>
    </div>
    <button type="submit" class="btn btn-warning">Salvar</button>
</form>
